# Copy this to .env and fill in your values

# PostgreSQL password (used by docker-compose for both db and app)
DB_PASSWORD=change_me_to_a_secure_password

# Flask secret key — generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_secret

# Local dev only (ignored by docker-compose, which builds DB_URL itself)
DB_URL=postgresql://postgres:change_me_to_a_secure_password@localhost:5432/smart_radio_monitor
